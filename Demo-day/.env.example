# Salin ke Demo-day/.env — dipakai terutama Hari 2 (deployment)
# cp .env.example .env

# --- Backend ---
MODEL_TYPE=bert
# bert | transformer
BERT_CHECKPOINT=models/bert_dream.bin
TRANSFORMER_CHECKPOINT=models/chatbot-v2.pt
TRANSFORMER_VOCAB=models/vocab.pkl
API_HOST=0.0.0.0
API_PORT=8000

# --- Discord bot ---
DISCORD_TOKEN=
API_URL=http://127.0.0.1:8000
BOT_PREFIX=!
MENTION_ONLY=false
